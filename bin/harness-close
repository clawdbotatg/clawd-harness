#!/bin/sh
# harness-close — ask the clawd-harness to close THIS session when the current
# turn ends. Only works while a human has armed it (the 📑 wrap chip, or the
# PM's `wrap` verb); otherwise the harness refuses and says so. The optional
# argument is a short reason for the log. See docs/DOC-AND-CLOSE-PLAN.md.
if [ -z "$HARNESS_CLOSE_URL" ]; then
  echo "harness-close: not running under the harness (HARNESS_CLOSE_URL unset)" >&2
  exit 2
fi
out=$(curl -sS -m 5 -X POST "$HARNESS_CLOSE_URL" --data-urlencode "reason=$*" -w '\n%{http_code}') || { echo "harness-close: could not reach the harness" >&2; exit 3; }
code=$(printf '%s\n' "$out" | tail -n 1)
msg=$(printf '%s\n' "$out" | sed '$d')
echo "harness-close: $msg"
[ "$code" = "200" ] || exit 1
