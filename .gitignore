# runtime / local state — never commit (comments on their own lines!)

# auth secret (wildcarded — a .bak of a secret is just as secret)
.clawd-harness.token*
# local secrets / config (BANKR_API_KEY etc.) — loaded by server.py at boot
.clawd-harness.env*
# local session id (legacy single-session) + multi-session registry
# (+ its .tmp<pid> atomic-write staging and .corrupt quarantine)
.clawd-harness.session*
# first-party prompt log (quick-chip ranking data) — local usage, may hold anything
.clawd-harness.prompts.jsonl*
# 📚 picker ✕-hidden skill names (machine-local UI state)
.clawd-harness.skills-hidden.json*
# generated; embed the token in curl URLs (one per session)
.clawd-harness.hooks.json
.clawd-harness.hooks.*.json
# pasted/uploaded images (may contain anything)
.clawd-harness-uploads/
# projects = cloned/created git repos we drive — never enter the harness repo
projects/

# fleet/ runtime state (relay/worker layer — see fleet/CLAUDE.md).
# Wildcarded: editor backups / tmp copies (.bak, .tmp<pid>, ~) of a secret
# file are just as secret as the original — an untracked .bak of the passkey
# roster sat committable for a week (2026-08-30).
fleet/.clawd-fleet.token*
fleet/.clawd-fleet.machine*
fleet/.clawd-fleet.passkeys.json*
fleet/.clawd-fleet.vapid.json*
fleet/.clawd-fleet.push-subs.json*
fleet/.clawd-fleet.prefs.json*
fleet/.fleet.worker_id.json*
fleet/.fleet.e2e_resume.json*
fleet/.fleet.e2e_resume.json.tmp
# relay edge-session tokens (bearer secrets, 24h TTL) — survive relay restarts
fleet/.clawd-fleet.sessions.json
fleet/.clawd-fleet.sessions.json.tmp
# the PRIVATE fleet skills library (canonical store on the relay box; may hold
# LAN-internal detail) — must never enter this public repo
fleet/.clawd-fleet.skills*
fleet/fleet.env
fleet/*.log

# os / editor cruft
.DS_Store
__pycache__/
*.pyc

# controller runtime + secrets (per-machine; never commit)
.env.controller
.env.controller.*
.clawd-controller.tasks.jsonl
controller/.mcp-config.json
.clawd-controller.prompt.txt
.clawd-controller.threads.json
.clawd-controller.model.txt
tools/*.png

